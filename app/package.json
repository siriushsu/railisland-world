{
  "name": "railisland-world-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-web.mjs",
    "verify": "node scripts/audit-app-readiness.mjs",
    "build:verify": "npm run build && npm run verify",
    "store:capture": "node scripts/capture-store-assets.mjs",
    "store:export": "node scripts/export-store-listing.mjs",
    "store:verify": "npm run store:export && node scripts/audit-store-submission.mjs",
    "release:online": "node scripts/check-public-submission-urls.mjs",
    "release:verify": "npm run build:verify && npm run store:verify",
    "sync": "npm run build && cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "esbuild": "0.28.1",
    "playwright": "1.61.1"
  }
}
